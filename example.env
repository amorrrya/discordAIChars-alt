BOT_TOKEN=YourBotTokenHere
CHANNEL_ID=YourChannelIdHere
ADMIN_ID=YourDiscordUserIdHere
PREFIX=!

# Local models through Ollama, node setup picks them for your PC
BASE_MODEL=gemma4:e4b
LOCAL_CONTEXT=16384
LOCAL_THINK=false
EMBED_MODEL=qwen3-embedding:0.6b
PICTURE_MODEL=

# Claude: set the key and BASE_MODEL=claude-opus-5-5. LOCAL_MODEL answers instead while the key is empty
ANTHROPIC_API_KEY=
LOCAL_MODEL=
CLAUDE_EFFORT=high
DIRECTOR_EFFORT=low
HISTORY_TOKENS=80000

IMAGE_RECOGNITION_MODEL=
MAXIMUM_MODEL_CHAIN=5

# A bot account per character shows typing and real replies, e.g. TOKEN_WREN=its bot token
